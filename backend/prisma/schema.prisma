generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  users       User[]
  invites     WorkspaceInvite[]
  dishes      Dish[]
  dishImages  DishImage[]
  recipes     Recipe[]
  mealRecords MealRecord[]
  feedbacks   Feedback[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("workspaces")
}

model User {
  id             String            @id @default(cuid())
  workspaceId    String
  email          String            @unique
  name           String
  passwordHash   String
  role           UserRole          @default(MEMBER)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  feedbacks      Feedback[]
  createdInvites WorkspaceInvite[] @relation("InviteCreator")
  usedInvites    WorkspaceInvite[] @relation("InviteUser")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([workspaceId])
  @@map("users")
}

enum UserRole {
  ADMIN
  MEMBER
}

model WorkspaceInvite {
  id              String    @id @default(cuid())
  workspaceId     String
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByUser   User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usedByUser      User?     @relation("InviteUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([usedByUserId])
  @@map("workspace_invites")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FeedbackRating {
  GOOD
  OK
  BAD
}

model Dish {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String?
  mealTypes   MealType[]   @default([LUNCH, DINNER])
  isActive    Boolean      @default(true)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  images      DishImage[]
  recipes     Recipe[]
  mealRecords MealRecord[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("dishes")
}

model DishImage {
  id          String    @id @default(cuid())
  workspaceId String
  dishId      String
  storageKey  String
  mimeType    String
  size        Int
  width       Int
  height      Int
  sortOrder   Int       @default(0)
  isCover     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([dishId])
  @@map("dish_images")
}

model Recipe {
  id          String    @id @default(cuid())
  workspaceId String
  dishId      String
  title       String
  content     String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([dishId])
  @@map("recipes")
}

model MealRecord {
  id          String     @id @default(cuid())
  workspaceId String
  dishId      String?
  title       String
  mealType    MealType
  eatenAt     DateTime
  note        String?
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish?      @relation(fields: [dishId], references: [id], onDelete: SetNull)
  feedbacks   Feedback[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workspaceId])
  @@index([dishId])
  @@map("meal_records")
}

model Feedback {
  id           String         @id @default(cuid())
  workspaceId  String
  mealRecordId String
  userId       String
  rating       FeedbackRating
  note         String?
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  mealRecord   MealRecord     @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([mealRecordId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("feedbacks")
}
