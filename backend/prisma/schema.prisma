generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  members      WorkspaceMember[]
  invites      WorkspaceInvite[]
  dishes       Dish[]
  dishImages   DishImage[]
  dishVariants DishVariant[]
  recipes      Recipe[]
  mealRecords  MealRecord[]
  feedbacks    Feedback[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("workspaces")
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String
  workspaces     WorkspaceMember[]
  feedbacks      Feedback[]
  createdInvites WorkspaceInvite[] @relation("InviteCreator")
  usedInvites    WorkspaceInvite[] @relation("InviteUser")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("users")
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        UserRole  @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

enum UserRole {
  ADMIN
  MEMBER
}

model WorkspaceInvite {
  id              String    @id @default(cuid())
  workspaceId     String
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByUser   User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  usedByUser      User?     @relation("InviteUser", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([usedByUserId])
  @@map("workspace_invites")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FeedbackRating {
  GOOD
  OK
  BAD
}

enum DishVariantType {
  HOME_RECIPE
  TAKEOUT
  DINE_IN
  OTHER
}

model Dish {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  mealTypes   MealType[]    @default([LUNCH, DINNER])
  isActive    Boolean       @default(true)
  deletedAt   DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  images      DishImage[]
  variants    DishVariant[]
  recipes     Recipe[]
  mealRecords MealRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, updatedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@map("dishes")
}

model DishImage {
  id          String    @id @default(cuid())
  workspaceId String
  dishId      String
  storageKey  String
  mimeType    String
  size        Int
  width       Int
  height      Int
  sortOrder   Int       @default(0)
  isCover     Boolean   @default(false)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([dishId])
  @@index([dishId, sortOrder, createdAt])
  @@map("dish_images")
}

model DishVariant {
  id          String          @id @default(cuid())
  workspaceId String
  dishId      String
  name        String
  description String?
  type        DishVariantType @default(OTHER)
  isActive    Boolean         @default(true)
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish            @relation(fields: [dishId], references: [id], onDelete: Cascade)
  mealRecords MealRecord[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([dishId, name])
  @@index([workspaceId])
  @@index([dishId])
  @@index([dishId, isActive(sort: Desc), createdAt, id])
  @@map("dish_variants")
}

model Recipe {
  id           String    @id @default(cuid())
  workspaceId  String
  dishId       String
  instructions String
  version      Int       @default(1)
  isActive     Boolean   @default(true)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish         Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([dishId, version])
  @@index([workspaceId])
  @@index([dishId])
  @@map("recipes")
}

model MealRecord {
  id          String       @id @default(cuid())
  workspaceId String
  dishId      String
  variantId   String?
  mealType    MealType
  eatenAt     DateTime
  note        String?
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  dish        Dish         @relation(fields: [dishId], references: [id], onDelete: Restrict)
  variant     DishVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  feedbacks   Feedback[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
  @@index([dishId])
  @@index([variantId])
  @@index([workspaceId, eatenAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, eatenAt])
  @@map("meal_records")
}

model Feedback {
  id           String         @id @default(cuid())
  workspaceId  String
  mealRecordId String
  userId       String
  rating       FeedbackRating
  note         String?
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  mealRecord   MealRecord     @relation(fields: [mealRecordId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([mealRecordId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([mealRecordId, rating])
  @@index([workspaceId, rating])
  @@map("feedbacks")
}
