# WaterMenu 生产环境变量模板。
# 部署时复制为 deploy/env/prod.env，并替换所有 change-me 值。

NODE_ENV=production
PORT=3000

POSTGRES_DB=watermenu
POSTGRES_USER=watermenu
POSTGRES_PASSWORD=change-me-strong-database-password

# 注意：DATABASE_URL 中的用户、密码、数据库名必须与上面的 POSTGRES_* 保持一致。
DATABASE_URL=postgresql://watermenu:change-me-strong-database-password@postgres:5432/watermenu?schema=public

SESSION_SECRET=change-me-at-least-32-random-characters-long
SESSION_COOKIE_NAME=watermenu.sid
SESSION_MAX_AGE_MS=604800000

# 仅供首次部署后手动 seed 使用；容器启动不会自动执行 seed。
SEED_WORKSPACE_NAME=WaterMenu
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me-initial-admin-password
SEED_USER_NAME=Admin
